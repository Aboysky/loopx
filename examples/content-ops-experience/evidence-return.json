{
  "schema_version": "content_ops_experience_v0",
  "title": "Return the evidence",
  "learning_goal": "Deliver reviewable evidence to the original requester within four effort units. Predict how context and the return route change the result.",
  "source_ref": "illustration:evidence-return",
  "boundary": "Finite teaching model, not a recorded Agent run.",
  "assumptions": [
    "Every action has a declared integer effort cost; time and human attention are not measured.",
    "Verification is one explicit model action. Reaching this model goal is not independent acceptance of real work."
  ],
  "initial_state": "intent",
  "budget": 4,
  "max_steps": 12,
  "parameters": [
    {
      "id": "context",
      "label": "Handoff context",
      "choices": [
        {
          "id": "complete",
          "label": "Goal, constraints and acceptance"
        },
        {
          "id": "missing",
          "label": "Goal only"
        }
      ],
      "default": "missing"
    },
    {
      "id": "return_route",
      "label": "Evidence return route",
      "choices": [
        {
          "id": "origin",
          "label": "Original requester"
        },
        {
          "id": "side",
          "label": "Side conversation"
        }
      ],
      "default": "origin"
    }
  ],
  "states": [
    {
      "id": "intent",
      "label": "One request",
      "description": "The requester keeps one goal and needs usable evidence.",
      "terminal": false,
      "goal": false
    },
    {
      "id": "clarification",
      "label": "Missing context",
      "description": "The receiver needs the constraints and acceptance before continuing.",
      "terminal": false,
      "goal": false
    },
    {
      "id": "working",
      "label": "Produce evidence",
      "description": "The receiver has the brief and is doing the work.",
      "terminal": false,
      "goal": false
    },
    {
      "id": "review",
      "label": "Original requester",
      "description": "Evidence is back in the original context, ready to verify.",
      "terminal": false,
      "goal": false
    },
    {
      "id": "lost",
      "label": "Wrong return route",
      "description": "The original requester cannot see the evidence yet.",
      "terminal": false,
      "goal": false
    },
    {
      "id": "accepted",
      "label": "Evidence verified",
      "description": "The model goal is met: the original requester has checked the returned evidence.",
      "terminal": true,
      "goal": true
    },
    {
      "id": "unaccepted",
      "label": "Claim without evidence",
      "description": "Declaring completion did not deliver verified evidence.",
      "terminal": true,
      "goal": false
    }
  ],
  "actions": [
    {
      "id": "delegate",
      "label": "Delegate the request",
      "cost": 1
    },
    {
      "id": "clarify",
      "label": "Supply missing constraints",
      "cost": 1
    },
    {
      "id": "return",
      "label": "Return the evidence",
      "cost": 1
    },
    {
      "id": "verify",
      "label": "Verify the returned evidence",
      "cost": 1
    },
    {
      "id": "reroute",
      "label": "Recover the original return route",
      "cost": 2
    },
    {
      "id": "claim_done",
      "label": "Declare completion immediately",
      "cost": 1
    }
  ],
  "transitions": [
    {
      "action": "delegate",
      "to": "working",
      "feedback": "The receiver can start with a complete brief.",
      "when": {
        "context": "complete"
      },
      "from": "intent"
    },
    {
      "action": "delegate",
      "to": "clarification",
      "feedback": "The receiver asks for the missing constraints.",
      "when": {
        "context": "missing"
      },
      "from": "intent"
    },
    {
      "action": "clarify",
      "to": "working",
      "feedback": "The missing context is supplied; the same receiver continues.",
      "when": {},
      "from": "clarification"
    },
    {
      "action": "return",
      "to": "review",
      "feedback": "Evidence returns to the original requester.",
      "when": {
        "return_route": "origin"
      },
      "from": "working"
    },
    {
      "action": "return",
      "to": "lost",
      "feedback": "Evidence went to a side conversation.",
      "when": {
        "return_route": "side"
      },
      "from": "working"
    },
    {
      "action": "reroute",
      "to": "review",
      "feedback": "The evidence is recovered in the original context.",
      "when": {},
      "from": "lost"
    },
    {
      "action": "verify",
      "to": "accepted",
      "feedback": "The original requester verifies the evidence.",
      "when": {},
      "from": "review"
    },
    {
      "action": "claim_done",
      "to": "unaccepted",
      "feedback": "The model records an unsupported completion claim.",
      "when": {},
      "from": "working"
    }
  ],
  "policies": [
    {
      "id": "evidence_first",
      "label": "Return and verify",
      "choices": [
        {
          "state": "intent",
          "action": "delegate"
        },
        {
          "state": "clarification",
          "action": "clarify"
        },
        {
          "state": "working",
          "action": "return"
        },
        {
          "state": "lost",
          "action": "reroute"
        },
        {
          "state": "review",
          "action": "verify"
        }
      ]
    },
    {
      "id": "shortcut",
      "label": "Fast completion claim",
      "choices": [
        {
          "state": "intent",
          "action": "delegate"
        },
        {
          "state": "clarification",
          "action": "clarify"
        },
        {
          "state": "working",
          "action": "claim_done"
        }
      ]
    }
  ],
  "scenarios": [
    {
      "id": "complete",
      "label": "Complete handoff",
      "parameters": {
        "context": "complete",
        "return_route": "origin"
      }
    },
    {
      "id": "missing",
      "label": "Missing constraints",
      "parameters": {
        "context": "missing",
        "return_route": "origin"
      }
    },
    {
      "id": "wrong_route",
      "label": "Missing context and wrong return route",
      "parameters": {
        "context": "missing",
        "return_route": "side"
      }
    }
  ]
}
