{
  "schema_version": "content_ops_experience_v0",
  "title": "Diagnose before changing a service",
  "learning_goal": "Find the declared bottleneck and restore the simulated service within four effort units. Compare a measured policy with a speculative restart.",
  "source_ref": "illustration:service-diagnosis",
  "boundary": "Finite synthetic service; no process is inspected or changed.",
  "assumptions": [
    "Only CPU and I/O faults exist in this model.",
    "A diagnostic reveals the configured fault perfectly. Real diagnosis and repair costs are not represented."
  ],
  "initial_state": "slow",
  "budget": 4,
  "max_steps": 8,
  "parameters": [
    {
      "id": "fault",
      "label": "Actual bottleneck",
      "choices": [
        {
          "id": "cpu",
          "label": "CPU saturation"
        },
        {
          "id": "io",
          "label": "I/O saturation"
        }
      ],
      "default": "cpu"
    }
  ],
  "states": [
    {
      "id": "slow",
      "label": "Slow service",
      "description": "The cause is unknown until a measurement is made.",
      "terminal": false,
      "goal": false
    },
    {
      "id": "cpu_found",
      "label": "CPU evidence",
      "description": "The measurement identified CPU saturation.",
      "terminal": false,
      "goal": false
    },
    {
      "id": "io_found",
      "label": "I/O evidence",
      "description": "The measurement identified I/O saturation.",
      "terminal": false,
      "goal": false
    },
    {
      "id": "restored",
      "label": "Service restored",
      "description": "The repair matched the measured fault.",
      "terminal": true,
      "goal": true
    },
    {
      "id": "unchanged",
      "label": "Still slow",
      "description": "A speculative restart did not address the model fault.",
      "terminal": true,
      "goal": false
    }
  ],
  "actions": [
    {
      "id": "measure",
      "label": "Measure CPU and I/O",
      "cost": 1
    },
    {
      "id": "limit_cpu",
      "label": "Reduce CPU contention",
      "cost": 2
    },
    {
      "id": "repair_io",
      "label": "Repair the I/O path",
      "cost": 2
    },
    {
      "id": "restart",
      "label": "Restart without measuring",
      "cost": 2
    }
  ],
  "transitions": [
    {
      "action": "measure",
      "to": "cpu_found",
      "feedback": "The measurement points to CPU contention.",
      "when": {
        "fault": "cpu"
      },
      "from": "slow"
    },
    {
      "action": "measure",
      "to": "io_found",
      "feedback": "The measurement points to the I/O path.",
      "when": {
        "fault": "io"
      },
      "from": "slow"
    },
    {
      "action": "restart",
      "to": "unchanged",
      "feedback": "The restart did not remove the configured fault.",
      "when": {},
      "from": "slow"
    },
    {
      "action": "limit_cpu",
      "to": "restored",
      "feedback": "The repair addresses the measured CPU fault.",
      "when": {},
      "from": "cpu_found"
    },
    {
      "action": "repair_io",
      "to": "restored",
      "feedback": "The repair addresses the measured I/O fault.",
      "when": {},
      "from": "io_found"
    }
  ],
  "policies": [
    {
      "id": "measure_first",
      "label": "Measure, then repair",
      "choices": [
        {
          "state": "slow",
          "action": "measure"
        },
        {
          "state": "cpu_found",
          "action": "limit_cpu"
        },
        {
          "state": "io_found",
          "action": "repair_io"
        }
      ]
    },
    {
      "id": "restart_first",
      "label": "Restart first",
      "choices": [
        {
          "state": "slow",
          "action": "restart"
        }
      ]
    }
  ],
  "scenarios": [
    {
      "id": "cpu",
      "label": "CPU fault",
      "parameters": {
        "fault": "cpu"
      }
    },
    {
      "id": "io",
      "label": "I/O fault",
      "parameters": {
        "fault": "io"
      }
    }
  ]
}
